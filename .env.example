# PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/pdf_processor
DB_USERNAME=pdf_user
DB_PASSWORD=pdf_password

# RabbitMQ broker
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# PDF storage
DOCUMENT_STORAGE_ROOT=../storage

# OCR settings
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGES=por+eng
